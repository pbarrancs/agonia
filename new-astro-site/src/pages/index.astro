---
// src/pages/index.astro
// Minimal brand landing page — logo, tagline, CTAs to Catálogo and Nosotros.

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="agonia" description="Colectivo independiente de ropa de escalada — México">
  <Nav slot="nav" />

  <div class="hero">
    <img
      class="hero__logo"
      src="/assets/images/Logos/Logo_horizontal/PNG_/logo_blanco.png"
      alt="agonia"
    />

    <p class="hero__tagline font-cuerpo">
      marca independiente
    </p>

    <div class="hero__cta">
      <a href="/catalogo" class="btn btn--primary">Ver catálogo</a>
      <a href="/nosotros" class="btn btn--secondary">Quiénes somos</a>
    </div>
  </div>

  <Footer slot="footer" />
</Layout>
